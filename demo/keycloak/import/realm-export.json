{
  "id": "bzhcamp",
  "realm": "bzhcamp",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "fr"
  ],
  "defaultLocale": "fr",
  "clients": [
    {
      "clientId": "app-springboot",
      "enabled": true,
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:8090",
      "baseUrl": "http://localhost:8090",
      "redirectUris": [
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "protocolMappers": [
        {
          "name": "audience-service-planets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-planets",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "keycloak-angular",
      "enabled": true,
      "bearerOnly": false,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "protocolMappers": [
        {
          "name": "audience-service-planets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-planets",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "service-planets",
      "name": "service-planets (resource server /8091)",
      "description": "Client representant l'API planets. Ne declenche aucun flux : porte les roles machine et sert d'audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "app-m2m",
      "name": "app-m2m (identite machine)",
      "description": "Client confidentiel machine-a-machine. serviceAccountsEnabled => grant_type=client_credentials autorise.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-service-planets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-planets",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@bzhcamp.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "service-account-app-m2m",
      "enabled": true,
      "serviceAccountClientId": "app-m2m",
      "clientRoles": {
        "service-planets": [
          "planets.read"
        ]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Rôle standard utilisateur"
      },
      {
        "name": "admin",
        "description": "Rôle administrateur"
      }
    ],
    "client": {
      "service-planets": [
        {
          "name": "planets.read",
          "description": "Lecture machine du catalogue de planetes (endpoint /internal/planets)",
          "clientRole": true
        }
      ]
    }
  },
  "groups": []
}
